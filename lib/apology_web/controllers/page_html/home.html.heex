<Layouts.flash_group flash={@flash} />

<div class="min-h-screen bg-base-100">
  <header class="py-16 px-4 text-center bg-gradient-to-b from-base-200 to-base-100">
    <h1 class="text-4xl md:text-5xl font-bold mb-4">Apology.io</h1>
    <p class="text-xl text-base-content/70 max-w-2xl mx-auto">
      Holding the powerful accountable through collective action
    </p>
  </header>

  <main class="max-w-6xl mx-auto px-4 py-12">
    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-6">Active Initiatives</h2>

      <%= if length(@initiatives) > 0 do %>
        <div class="grid gap-6">
          <%= for initiative <- @initiatives do %>
            <.link navigate={~p"/i/#{initiative.slug}"} class="block">
              <div class="card bg-base-200 hover:bg-base-300 transition-colors shadow-lg">
                <div class="card-body">
                  <h3 class="card-title text-xl md:text-2xl">{initiative.title}</h3>
                  <p :if={initiative.tagline} class="text-base-content/70">
                    {initiative.tagline}
                  </p>
                  <div class="card-actions justify-end mt-4">
                    <div class="badge badge-primary">View Initiative →</div>
                  </div>
                </div>
              </div>
            </.link>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-12 text-base-content/60">
          <p>No active initiatives yet.</p>
        </div>
      <% end %>
    </section>
  </main>

  <footer class="py-8 text-center text-base-content/60 text-sm">
    <p>Demanding accountability, one signature at a time.</p>
  </footer>
</div>
