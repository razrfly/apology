<div class="min-h-screen">
  <!-- Header -->
  <header class="py-16 px-6 lg:px-10">
    <div class="mx-auto w-full max-w-2xl md:max-w-3xl lg:max-w-7xl text-center">
      <h1 class="font-display text-5xl/12 tracking-tight text-balance sm:text-[5rem]/20 text-olive-950 dark:text-white">
        Apology.io
      </h1>
      <p class="mt-6 text-lg/7 text-olive-600 dark:text-olive-300 max-w-2xl mx-auto">
        Holding the powerful accountable through collective action
      </p>
    </div>
  </header>

  <!-- Main Content -->
  <main class="mx-auto w-full max-w-2xl px-6 md:max-w-3xl lg:max-w-7xl lg:px-10 pb-16">
    <section>
      <h2 class="font-display text-2xl tracking-tight text-olive-950 dark:text-white mb-8">
        Active Initiatives
      </h2>

      <%= if length(@initiatives) > 0 do %>
        <div class="grid gap-6">
          <%= for initiative <- @initiatives do %>
            <.link navigate={~p"/i/#{initiative.slug}"} class="block group">
              <article class="rounded-2xl bg-white dark:bg-olive-900 p-8 shadow-sm ring-1 ring-olive-950/5 dark:ring-white/10 transition hover:shadow-md hover:ring-olive-950/10 dark:hover:ring-white/20">
                <h3 class="font-display text-2xl tracking-tight text-olive-950 dark:text-white group-hover:text-olive-700 dark:group-hover:text-olive-200 transition">
                  {initiative.title}
                </h3>
                <p :if={initiative.tagline} class="mt-3 text-olive-600 dark:text-olive-300">
                  {initiative.tagline}
                </p>
                <div class="mt-6 flex items-center gap-2 text-sm font-medium text-olive-950 dark:text-white">
                  <span>View Initiative</span>
                  <svg class="h-4 w-4 transition group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </div>
              </article>
            </.link>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-16 text-olive-500 dark:text-olive-400">
          <p>No active initiatives yet.</p>
        </div>
      <% end %>
    </section>
  </main>

  <!-- Footer -->
  <footer class="py-8 text-center text-olive-500 dark:text-olive-400 text-sm">
    <p>Demanding accountability, one signature at a time.</p>
  </footer>
</div>
